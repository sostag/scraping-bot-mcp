{
  "name": "@sostag/scraping-bot-mcp",
  "version": "1.4.1",
  "description": "MCP server for ScrapingBot: let Claude, Cursor and other AI agents scrape web pages, products, real estate, travel, search engines and social media.",
  "type": "module",
  "bin": {
    "scraping-bot-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "dev:http": "PORT=8090 SCRAPING_BOT_API_URL=http://localhost:4000 PUBLIC_URL=http://localhost:8090 SITE_URL=http://localhost:3000 tsx watch --env-file-if-exists=.env src/http-server.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "test:live": "npm run build && node test/live.js",
    "start:http": "node dist/http-server.js",
    "secretlint": "secretlint --secretlintignore .secretlintignore \"**/*\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "scraping",
    "web-scraping",
    "claude",
    "ai-agents"
  ],
  "homepage": "https://www.scraping-bot.io/mcp-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sostag/scraping-bot-mcp.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jose": "^6.2.12",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.0",
    "secretlint": "^13.0.7",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/secretlint-staged.mjs"
  }
}
