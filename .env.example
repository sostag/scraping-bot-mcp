# Local development of the remote (HTTP) mode: npm run dev:http (port 8090,
# local API on 4000 and website on 3000). Copy to .env (ignored by git).

# OAuth ("Sign in with ScrapingBot"): same value as OAUTH_SECRET in
# ../scrapingbot-scraper/.env, at least 16 characters. Without it, only the
# API key headers work.
OAUTH_SECRET=

# Same value as INTERNAL_PROXY_SECRET in the API: forwards the client's IP
INTERNAL_PROXY_SECRET=
